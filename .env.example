# ====================================================================
# 🎙️ Rexa Voice Assistant - Environment Variables
# Copy this file to '.env' and fill in your keys:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# ====================================================================

# Google Gemini API Key (Required for conversational intelligence)
# Get a free API key at: https://aistudio.google.com/app/apikey
Gemini_KEY=your_gemini_api_key_here

# Owner voice verification passkey (Default: shaheer)
# Rexa requires this spoken name/password upon initial activation
OWNER_NAME=shaheer

# (Optional) GNews API Key for live top headlines
# Get a free key at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here
